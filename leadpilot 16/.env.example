# =====================  START HERE  =====================
# run.py (or double-clicking start.command / start.bat) creates .env from this file for you
# and fills in SECRET_KEY. You only need to change what you want from this short list, then save:
#   1) AI: set ANTHROPIC_API_KEY=..., OR set LLM_PROVIDER=ollama to use a free local model.
#   2) Email (optional): set CHAT_EMAIL_ENABLED=true and fill in the SMTP_ lines near the bottom.
# Everything else can stay as it is. NEVER commit your real .env to GitHub (.gitignore already blocks it).
# =========================================================

# --- App ---
APP_NAME=LeadPilot
APP_URL=http://localhost:8000
SUPPORT_EMAIL=support@example.com
# Generate with: python scripts/gen_key.py   (must be 32+ characters)
SECRET_KEY=
# Optional comma-separated Fernet keys (newest first). If empty, a key is derived from SECRET_KEY.
TOKEN_ENCRYPTION_KEYS=
# SQLite for local dev, Postgres for production:
DATABASE_URL=sqlite:///./leadpilot.db
# DATABASE_URL=postgresql://leadpilot:CHANGE_ME@postgres:5432/leadpilot
DRY_RUN=true
# Set to true when served over HTTPS (production)
COOKIE_SECURE=false
SESSION_MAX_AGE=28800
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOG_LEVEL=INFO

# --- Anthropic (powers ICP generation and the AI panel on the right) ---
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
CLAUDE_MODEL_MAIN=claude-sonnet-5-5
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001
# USD per million tokens, used only for cost tracking. Check Anthropic pricing and adjust.
PRICE_MAIN_IN_PER_MTOK=3.0
PRICE_MAIN_OUT_PER_MTOK=15.0
PRICE_FAST_IN_PER_MTOK=1.0
PRICE_FAST_OUT_PER_MTOK=5.0
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_RATE_PER_MINUTE=30
CHAT_RATE_PER_MINUTE=20
# Overall monthly paid-API budget shown on the dashboard and costs page
MONTHLY_BUDGET_USD=150
# Optional model overrides (empty = CLAUDE_MODEL_MAIN). Use CLAUDE_MODEL_FAST's name for cheaper/faster.
ASSISTANT_MODEL=
SELFCHECK_MODEL=

# --- Provider choice: "anthropic" (default) or "ollama" (local / self-hosted model, no per-token cost) ---
LLM_PROVIDER=anthropic
# Optional: use a different provider only for the AI panel (e.g. ollama for chat, anthropic for emails)
ASSISTANT_PROVIDER=

# --- Ollama (the SERVER calls Ollama; browsers never do, so no CORS / mixed-content setup is needed) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Only if Ollama sits behind a reverse proxy that checks a bearer token
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3.1:8b
# Optional smaller model for the reviewer pass (empty = same as OLLAMA_MODEL)
OLLAMA_FAST_MODEL=
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=4096
OLLAMA_TEMPERATURE=0.4
OLLAMA_STRUCTURED_TEMPERATURE=0.2
OLLAMA_TOP_P=0.9
OLLAMA_REPEAT_PENALTY=1.1
# Leave empty to let Ollama decide
OLLAMA_NUM_GPU=
OLLAMA_NUM_THREAD=
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_MAX_CONCURRENCY=2
OLLAMA_QUEUE_TIMEOUT_SECONDS=60
OLLAMA_WARMUP=true

# --- Email from the AI panel (optional) ---
# Turns on the "Email" button and the chat command "send hi to name@example.com".
# Every send needs your confirmation. For Gmail: turn on 2-Step Verification, then create an
# App Password at https://myaccount.google.com/apppasswords and paste the 16 letters below
# (spaces are fine). Never use your normal Gmail password here.
CHAT_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional "From" address (empty = SMTP_USER)
SMTP_FROM=

# Only set to true when you run the app on a server and need the first-run /setup page from another computer.
ALLOW_REMOTE_SETUP=false
